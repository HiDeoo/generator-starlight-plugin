{
  "name": "@hideoo/generator-starlight-plugin",
  "version": "0.7.1",
  "license": "MIT",
  "description": "Yeoman generator for Starlight plugins.",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "lint": "eslint . --cache --max-warnings=0 && tsc --noEmit",
    "format": "prettier -w --cache --ignore-unknown .",
    "version": "pnpm changeset version && pnpm i --no-frozen-lockfile",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "camelcase": "^9.0.0",
    "latest-version": "^9.0.0",
    "yeoman-generator": "^8.1.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@hideoo/eslint-config": "^4.1.1",
    "@hideoo/prettier-config": "^2.0.1",
    "@hideoo/tsconfig": "^2.0.3",
    "eslint": "^9.39.4",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.32.1",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "yeoman-generator",
    "starlight",
    "plugin",
    "documentation",
    "astro"
  ],
  "homepage": "https://github.com/HiDeoo/generator-starlight-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiDeoo/generator-starlight-plugin.git"
  },
  "bugs": "https://github.com/HiDeoo/generator-starlight-plugin/issues",
  "prettier": "@hideoo/prettier-config"
}
