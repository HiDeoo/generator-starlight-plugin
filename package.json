{
  "name": "@hideoo/generator-starlight-plugin",
  "version": "0.9.0",
  "license": "MIT",
  "description": "Yeoman generator for Starlight plugins.",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "lint": "eslint . --cache --max-warnings=0 && tsc --noEmit",
    "format": "prettier -w --cache --ignore-unknown .",
    "version": "pnpm changeset version && pnpm i --no-frozen-lockfile",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "camelcase": "^9.0.0",
    "fast-npm-meta": "^1.5.1",
    "yeoman-generator": "^8.1.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@hideoo/eslint-config": "^5.2.1",
    "@hideoo/prettier-config": "^2.0.2",
    "@hideoo/tsconfig": "^2.0.4",
    "eslint": "^10.10.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "yeoman-generator",
    "starlight",
    "plugin",
    "documentation",
    "astro"
  ],
  "homepage": "https://github.com/HiDeoo/generator-starlight-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiDeoo/generator-starlight-plugin.git"
  },
  "bugs": "https://github.com/HiDeoo/generator-starlight-plugin/issues",
  "prettier": "@hideoo/prettier-config"
}
